# --- LLM providers (both have free tiers) ---
GROQ_API_KEY=
GEMINI_API_KEY=

# provider:model per agent role. Verify IDs on each provider's models page.
HIREFLOW_MODEL_EXTRACT=groq:openai/gpt-oss-120b
HIREFLOW_MODEL_REASON=groq:qwen/qwen3.8-27b
HIREFLOW_MODEL_LIGHT=groq:openai/gpt-oss-20b
HIREFLOW_MODEL_FALLBACK=gemini:gemini-flash-latest

HIREFLOW_MAX_ITER=5

# Optional web search upgrade. Empty = DuckDuckGo fallback.
TAVILY_API_KEY=

# Optional. Only if you switch a role to e.g. anthropic:claude-sonnet-5
ANTHROPIC_API_KEY=
# Optional: makes GitHub checks more reliable (github.com/settings/tokens, no scopes needed)
GITHUB_TOKEN=
HIREFLOW_MAX_TOOL_CALLS=10
HIREFLOW_MAX_RPM=20